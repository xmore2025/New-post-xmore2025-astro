# Cloudflare Pages 响应头
# 文档：https://developers.cloudflare.com/pages/configuration/headers/

# 注：COOP 不能写 same-origin。giscus 的 GitHub 登录走弹窗，same-origin 会让弹窗
# 拿不到 window.opener，登录回调无法 postMessage 回来（表现是「点了登录没反应」）。
# allow-popups 只在弹窗场景放宽，页面本身仍与外部文档隔离。
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  X-Permitted-Cross-Domain-Policies: none
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Astro 产物文件名带内容哈希，内容变化 URL 随之变化，可安全长缓存
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 字体子集：文件名带内容哈希，可长缓存
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# 静态资源：长缓存
/*.svg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8

# 安全披露信息：一天缓存，改了能较快生效
/.well-known/*
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# 订阅源与站点地图：短缓存
/*.xml
  Cache-Control: public, max-age=3600

# 搜索索引：短缓存
/search.json
  Cache-Control: public, max-age=600
