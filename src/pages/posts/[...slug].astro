---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config';
import { fmtDate, getPosts, isoDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prev: posts[index - 1] ?? null,
      next: posts[index + 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post.entry);

const shareUrl = new URL(Astro.url.pathname, site.url).href;
const shareTitle = encodeURIComponent(post.title);
const encodedShareUrl = encodeURIComponent(shareUrl);
const published = isoDate(post.date);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: published,
  dateModified: published,
  inLanguage: site.lang,
  image: `${site.url}/og.png`,
  keywords: post.tags.map((tag) => tag.name).join(', '),
  author: { '@type': 'Person', name: site.author, url: site.url },
  publisher: { '@type': 'Organization', name: site.title, url: site.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': shareUrl },
};
---

<BaseLayout
  title={post.title}
  description={post.description}
  bodyClass="page-post"
  type="article"
  published={published}
  structuredData={structuredData}
>
  <div class="progress" data-progress aria-hidden="true"></div>

  <article class="shell">
    <div class="article">
      <nav class="crumb" aria-label="面包屑">
        <a href="/posts/">文章</a>
        <span aria-hidden="true">/</span>
        <span>{post.tags[0]?.name ?? '随笔'}</span>
      </nav>

      <header class="article-head">
        <h1>{post.title}</h1>
        <p class="article-desc">{post.description}</p>

        <div class="article-meta">
          <span class="meta-item">
            <Icon name="calendar" />
            <time datetime={published}>{fmtDate(post.date)}</time>
          </span>
          <span class="sep" aria-hidden="true"></span>
          <span class="meta-item"><Icon name="clock" />{post.readingTime} 分钟阅读</span>
          <span class="sep" aria-hidden="true"></span>
          <span class="meta-item">{site.author}</span>
        </div>

        <TagList tags={post.tags} />
      </header>

      <div class="article-layout">
        <div class="article-main">
          <div class="prose">
            <Content />
          </div>

          <nav class="article-nav" aria-label="上一篇 / 下一篇">
            {
              prev ? (
                <a href={`/posts/${prev.slug}/`}>
                  <span class="label">
                    <Icon name="arrowLeft" /> 更新
                  </span>
                  <span class="t">{prev.title}</span>
                </a>
              ) : (
                <span />
              )
            }
            {
              next ? (
                <a href={`/posts/${next.slug}/`} class="next">
                  <span class="label">
                    更早 <Icon name="arrowRight" />
                  </span>
                  <span class="t">{next.title}</span>
                </a>
              ) : (
                <span />
              )
            }
          </nav>
        </div>

        <aside class="article-sidebar" aria-label="文章辅助导航">
          {
            headings.length > 0 && (
              <nav class="article-toc" aria-label="本文目录">
                <h2 class="sidebar-title">本文目录</h2>
                <ol>
                  {headings.map((heading) => (
                    <li class={`toc-item toc-item--${heading.depth}`}>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }

          <section class="article-share" aria-labelledby="share-title">
            <h2 class="sidebar-title" id="share-title">分享文章</h2>
            <div class="share-links" role="group" aria-label="分享到社交平台">
              <a
                class="share-link"
                href={`https://twitter.com/intent/tweet?url=${encodedShareUrl}&text=${shareTitle}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="分享到 X"
                title="X"><Icon name="x" /></a
              >
              <a
                class="share-link"
                href={`https://t.me/share/url?url=${encodedShareUrl}&text=${shareTitle}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="分享到 Telegram"
                title="Telegram"><Icon name="telegram" /></a
              >
              <a
                class="share-link"
                href={`mailto:?subject=${shareTitle}&body=${encodedShareUrl}`}
                aria-label="通过电子邮件分享"
                title="电子邮件"><Icon name="mail" /></a
              >
              <button
                class="share-link"
                type="button"
                data-share-copy
                aria-label="复制链接"
                title="复制链接"><Icon name="link" /></button
              >
            </div>
            <span class="share-status" data-share-status role="status" aria-live="polite"></span>
          </section>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
