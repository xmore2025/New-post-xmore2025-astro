---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, getTags } from '../../lib/posts';

const posts = await getPosts();
const tags = await getTags();
const totalPosts = posts.length;

/** 标签 → emoji，保持视觉趣味；未收录的用默认标签图标 */
const tagEmojiMap = {
  rust: '🦀',
  javascript: '🟨',
  typescript: '🔷',
  react: '⚛️',
  vue: '💚',
  astro: '🚀',
  css: '🎨',
  golang: '🐹',
  php: '🐘',
  laravel: '🐛',
  nginx: '🐕‍🦺',
  mysql: '🐬',
  kubernetes: '☸️',
  docker: '🐳',
  life: '💃',
  books: '🔖',
  tool: '🪜',
  engineering: '🛠️',
  design: '✏️',
  ai: '🤖',
  'open-source': '🌱',
  writing: '✍️',
  default: '🏷️',
};

/** 标签 → 一句话说明，让卡片有内容可读 */
const tagDescMap = {
  engineering: '工程实践、架构取舍与长期维护。',
  design: '视觉语言、交互细节与版式节奏。',
  ai: '模型能力、智能体与工具链的边界。',
  astro: '静态站点、内容建模与渲染策略。',
  css: '布局系统、动效与样式的可维护性。',
  'open-source': '开源生态、协作方式与项目治理。',
  typescript: '类型系统如何真正降低维护成本。',
  writing: '把想法整理成可读文字的练习。',
};

/**
 * 尺寸分配：按文章数决定，避免"只有 1 篇却占 2×2"的空卡。
 * 头部多产标签给 large / wide，第 4 个给 tall，其余 normal。
 * 配合 grid-auto-flow: dense，后面的小卡自动回填空位。
 */
const pickSize = (i, count) => {
  if (i === 0) return count >= 2 ? 'large' : 'normal';
  if (i === 1) return 'wide';
  if (i === 3) return count >= 2 ? 'tall' : 'normal';
  return 'normal';
};

const tagCategories = tags.map((tag, i) => ({
  name: tag.name,
  slug: tag.slug,
  href: `/tags/${tag.slug}/`,
  count: tag.count,
  desc: tagDescMap[tag.slug] ?? '',
  emoji: tagEmojiMap[tag.slug] ?? tagEmojiMap.default,
  size: pickSize(i, tag.count),
  /** 最新几篇，用于大卡片的预览列表 */
  recent: tag.posts.slice(0, 3).map((post) => post.title),
  placeholder: false,
}));

const placeholderCategories = [
  {
    name: '应用列表',
    slug: 'apps',
    href: '/categories/apps/',
    count: 0,
    desc: '精选应用与工具推荐。',
    emoji: '📱',
    size: 'normal',
    recent: [],
    placeholder: true,
  },
  {
    name: '收藏',
    slug: 'bookmarks',
    href: '/categories/bookmarks/',
    count: 0,
    desc: '值得反复阅读的文章与资源。',
    emoji: '🔖',
    size: 'normal',
    recent: [],
    placeholder: true,
  },
  {
    name: '图库',
    slug: 'gallery',
    href: '/categories/gallery/',
    count: 0,
    desc: '截图、设计稿与视觉记录。',
    emoji: '🖼️',
    size: 'normal',
    recent: [],
    placeholder: true,
  },
  {
    name: '工具',
    slug: 'tools',
    href: '/categories/tools/',
    count: 0,
    desc: '日常使用的开发与效率工具。',
    emoji: '🧰',
    size: 'normal',
    recent: [],
    placeholder: true,
  },
  {
    name: '导航',
    slug: 'navigation',
    href: '/categories/navigation/',
    count: 0,
    desc: '常用网站与资源导航。',
    emoji: '🧭',
    size: 'normal',
    recent: [],
    placeholder: true,
  },
];

const categories = [...tagCategories, ...placeholderCategories];
---

<BaseLayout
  title="分类"
  description="按主题浏览内容：标签分类、应用列表、收藏、图库、工具与导航"
  bodyClass="page-categories"
>
  <div class="shell">
    <header class="page-head">
      <p class="kicker">CATEGORIES</p>
      <h1>分类</h1>
      <p class="page-lede">
        {tags.length} 个标签，{totalPosts} 篇文章。更多分类板块筹备中。
      </p>
    </header>

    <section class="cat-grid">
      {
        categories.map((cat) => (
          <a
            class:list={[
              'cat-card',
              `cat-card--${cat.size}`,
              { 'cat-card--placeholder': cat.placeholder },
            ]}
            href={cat.href}
          >
            <div class="cat-card-bg" aria-hidden="true" />
            <div class="cat-card-body">
              <h2 class="cat-card-title">
                <span class="cat-card-emoji">{cat.emoji}</span>
                {cat.name}
              </h2>
              {cat.desc && <p class="cat-card-desc">{cat.desc}</p>}
              {cat.recent.length > 0 &&
                (cat.size === 'large' || cat.size === 'tall') && (
                  <ul class="cat-card-list">
                    {cat.recent.map((title) => (
                      <li>{title}</li>
                    ))}
                  </ul>
                )}
              <div class="cat-card-meta">
                <span class="cat-card-count">
                  <Icon name="hash" />
                  {cat.count} 篇
                </span>
                {cat.placeholder ? (
                  <span class="cat-card-badge">筹备中</span>
                ) : (
                  <span class="cat-card-arrow" aria-hidden="true">
                    <Icon name="arrowUpRight" />
                  </span>
                )}
              </div>
            </div>
          </a>
        ))
      }
    </section>
  </div>
</BaseLayout>
