---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getTags } from '../../lib/posts';

const tags = await getTags();
const totalPosts = tags.reduce((sum, tag) => tag.count, 0);

/** 为每个标签分配一个 emoji，保持视觉趣味 */
const tagEmojiMap = {
  rust: '🦀',
  javascript: '🟨',
  typescript: '🔷',
  react: '⚛️',
  vue: '💚',
  astro: '🚀',
  css: '🎨',
  golang: '🐹',
  php: '🐘',
  laravel: '🐛',
  nginx: '🐕‍🦺',
  mysql: '🐬',
  kubernetes: '☸️',
  docker: '🐳',
  life: '💃',
  books: '🔖',
  tool: '🪜',
  default: '🏷️',
};

/**
 * Bento 卡片尺寸循环：large(2x2) → wide(2x1) → normal(1x1) → tall(1x2)
 * 让已有标签按照数量排序后依次套用，占位分类默认 normal。
 */
const sizeCycle = ['large', 'wide', 'normal', 'tall'];

const tagCategories = tags.map((tag, i) => ({
  name: tag.name,
  slug: tag.slug,
  href: `/tags/${tag.slug}/`,
  count: tag.count,
  desc: '',
  emoji: tagEmojiMap[tag.slug] ?? tagEmojiMap.default,
  size: sizeCycle[i % sizeCycle.length],
  placeholder: false,
}));

const placeholderCategories = [
  {
    name: '应用列表',
    slug: 'apps',
    href: '/categories/apps/',
    count: 0,
    desc: '精选应用与工具推荐。',
    emoji: '📱',
    size: 'normal',
    placeholder: true,
  },
  {
    name: '收藏',
    slug: 'bookmarks',
    href: '/categories/bookmarks/',
    count: 0,
    desc: '值得反复阅读的文章与资源。',
    emoji: '🔖',
    size: 'normal',
    placeholder: true,
  },
  {
    name: '图库',
    slug: 'gallery',
    href: '/categories/gallery/',
    count: 0,
    desc: '截图、设计稿与视觉记录。',
    emoji: '🖼️',
    size: 'normal',
    placeholder: true,
  },
  {
    name: '工具',
    slug: 'tools',
    href: '/categories/tools/',
    count: 0,
    desc: '日常使用的开发与效率工具。',
    emoji: '🛠️',
    size: 'normal',
    placeholder: true,
  },
  {
    name: '导航',
    slug: 'navigation',
    href: '/categories/navigation/',
    count: 0,
    desc: '常用网站与资源导航。',
    emoji: '🧭',
    size: 'normal',
    placeholder: true,
  },
];

const categories = [...tagCategories, ...placeholderCategories];
---

<BaseLayout
  title="分类"
  description="按主题浏览内容：标签分类、应用列表、收藏、图库、工具与导航"
  bodyClass="page-categories"
>
  <div class="shell">
    <header class="page-head">
      <p class="kicker">CATEGORIES</p>
      <h1>分类</h1>
      <p class="page-lede">
        {tags.length} 个标签，{totalPosts} 篇文章。更多分类板块筹备中。
      </p>
    </header>

    <section class="cat-grid">
      {
        categories.map((cat) => (
          <a
            class:list={[
              'cat-card',
              `cat-card--${cat.size}`,
              { 'cat-card--placeholder': cat.placeholder },
            ]}
            href={cat.href}
          >
            <div class="cat-card-bg" aria-hidden="true" />
            <div class="cat-card-body">
              <h2 class="cat-card-title">
                <span class="cat-card-emoji">{cat.emoji}</span>
                {cat.name}
              </h2>
              {cat.desc ? (
                <p class="cat-card-desc">{cat.desc}</p>
              ) : (
                <p class="cat-card-desc cat-card-desc--empty">暂无描述</p>
              )}
              <div class="cat-card-meta">
                <span class="cat-card-count">
                  <Icon name="hash" />
                  {cat.count} 篇
                </span>
                {cat.placeholder ? (
                  <span class="cat-card-badge">筹备中</span>
                ) : (
                  <span class="cat-card-arrow" aria-hidden="true">
                    <Icon name="arrowUpRight" />
                  </span>
                )}
              </div>
            </div>
          </a>
        ))
      }
    </section>
  </div>
</BaseLayout>
