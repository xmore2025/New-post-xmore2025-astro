---
import '../styles/typography.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import TypeSpecimen from '../components/TypeSpecimen.astro';
import TypeSample from '../components/TypeSample.astro';
import Icon from '../components/Icon.astro';
import { RULES, SPECIMENS } from '../lib/specimens';

const description =
  '五项参数决定一篇文章好不好读：字号 10.5–13pt、行距 1.5–1.75、每行 30–40 字、段间距 0.5–1 行、字体不超过 3 种。字号上限按楷体留了 1pt 补偿——楷体字面小，同字号视觉比黑体小一档。五套完整样张，可编辑、可套用、可直接抄走 CSS。';

/* 试验台默认用站点自己的字族（霞鹜文楷），读者一进页面看到的就是熟悉的字 */
const DEFAULT_FONT = SPECIMENS[2].font;

/* 试验台的四个滑杆：区间比"建议值"宽，故意留出越界的余地 */
const CONTROLS = [
  {
    key: 'size',
    label: '字号',
    min: 9,
    max: 18,
    step: 0.5,
    value: 11.5,
    hint: '建议 10.5–13 pt · 楷体取上沿',
  },
  {
    key: 'lh',
    label: '行距',
    min: 1.3,
    max: 2,
    step: 0.05,
    value: 1.6,
    hint: '建议 1.5–1.75 · 中文 1.6 起步',
  },
  { key: 'measure', label: '行宽', min: 24, max: 46, step: 1, value: 34, hint: '建议 30–40 字' },
  { key: 'gap', label: '段距', min: 0, max: 1.4, step: 0.05, value: 0.75, hint: '建议 0.5–1 行' },
];

const FLAGS = [
  { key: 'trim', label: '标点挤压', on: true },
  { key: 'indent', label: '首行缩进', on: false },
  { key: 'tabular', label: '数字等宽', on: false },
  { key: 'autospace', label: '中西文间距', on: false },
  { key: 'pretty', label: '孤行控制', on: true },
  { key: 'grid', label: '基线网格', on: false },
];

const DECOS = [
  {
    name: '标点挤压',
    css: 'text-spacing-trim: trim-start',
    note: '行首的全角标点自动收窄半个字，段落左边缘不会因为一个「「」而参差。',
  },
  {
    name: '悬挂标点',
    css: 'hanging-punctuation: allow-end',
    note: '行末的逗号句号挂进页边，正文右侧才是一条真正的直线（目前 Safari 支持）。',
  },
  {
    name: '孤行控制',
    css: 'text-wrap: pretty',
    note: '最后一行只剩一两个字时，让浏览器重新分配前面几行，避免「悬孤」。',
  },
  {
    name: '首行缩进',
    css: 'text-indent: 2em',
    note: '与段间距二选一。两个同时用，等于把「这里分段」说了两遍。',
  },
  {
    name: '中西文间距',
    css: 'text-autospace: normal',
    note: '汉字与拉丁字母、数字之间自动留 1/4 字宽，不必手动敲空格（Chrome 123+）。',
  },
  {
    name: '数字等宽',
    css: 'font-variant-numeric: tabular-nums',
    note: '表格与目录里的数字上下对齐，扫一列数字时视线不会左右跳。',
  },
  {
    name: '合成字重',
    css: 'font-synthesis-weight: none',
    note: '字体没有真粗体时，宁可退回 600 也不让浏览器描边加粗——中文描边会糊、字距会不均。',
  },
  {
    name: '慎用两端对齐',
    css: 'text-align: justify',
    note: '中文两端对齐会在标点处拉出「白色河流」，行宽越窄越明显。除非行宽足够长，否则保持左对齐。',
  },
];
---

<BaseLayout
  title="排印实验室"
  description={description}
  path="/typography/"
  bodyClass="page-typography"
>
  <div class="shell">
    <header class="page-head">
      <p class="kicker">TYPOGRAPHY</p>
      <h1>排印实验室</h1>
      <p class="page-lede">
        一篇文章好不好读，八成由五个数字决定。<strong>字号、行距、行宽、段距、字体数量</strong>
        ——这几项设错，再好的字体也白搭。下面的试验台可以直接拖，五张样张可以直接改，改完挑一套抄走。
      </p>
      <div class="ty-meta">
        <span>5 套方案</span>
        <span class="sep" aria-hidden="true"></span>
        <span>5 条硬规则</span>
        <span class="sep" aria-hidden="true"></span>
        <span>8 处修饰</span>
        <span class="sep" aria-hidden="true"></span>
        <span>全部可编辑</span>
      </div>
    </header>

    <!-- 1. 硬规则 ------------------------------------------------------ -->
    <section class="ty-section">
      <SectionHead label="五条硬规则" />
      <ul class="rules">
        {RULES.map((rule, i) => (
          <li class="rule" data-rule={rule.key}>
            <span class="rule-idx">{String(i + 1).padStart(2, '0')}</span>
            <span class="rule-name">{rule.name}</span>
            <span class="rule-spec">{rule.spec}</span>
            <span class="rule-live">
              <b data-live={rule.key}>{rule.init}</b>
            </span>
          </li>
        ))}
      </ul>
      <p class="ty-lede" style="margin-top:0.85rem">
        这五个数字随试验台实时变化，越界的项会立刻变红 —— 先看红线，再谈字体。
      </p>
    </section>

    <!-- 2. 试验台 ------------------------------------------------------ -->
    <section class="ty-section">
      <SectionHead label="试验台" />

      <div class="lab" id="lab" data-font={DEFAULT_FONT}>
        <div class="lab-bar">
          {CONTROLS.map((ctrl) => (
            <div class="ctrl">
              <div class="ctrl-head">
                <label for={`ctl-${ctrl.key}`}>{ctrl.label}</label>
                <output for={`ctl-${ctrl.key}`} data-out={ctrl.key}>
                  {ctrl.key === 'size'
                    ? `${ctrl.value} pt`
                    : ctrl.key === 'measure'
                      ? `${ctrl.value} 字`
                      : ctrl.key === 'gap'
                        ? `${ctrl.value.toFixed(2)} 行`
                        : ctrl.value.toFixed(2)}
                </output>
              </div>
              <input
                class="ctrl-range"
                id={`ctl-${ctrl.key}`}
                type="range"
                min={ctrl.min}
                max={ctrl.max}
                step={ctrl.step}
                value={ctrl.value}
                data-ctl={ctrl.key}
              />
              <p class="ctrl-hint">{ctrl.hint}</p>
            </div>
          ))}
        </div>

        <div class="lab-flags" role="group" aria-label="排版修饰开关">
          <span class="lab-flags-label">修饰</span>
          {FLAGS.map((flag) => (
            <label class="flag" class:list={[{ 'is-on': flag.on }]}>
              <input type="checkbox" data-flag={flag.key} checked={flag.on} />
              <span>{flag.label}</span>
            </label>
          ))}
        </div>

        <div class="lab-body">
          <div class="lab-main">
            <div class="lab-paper">
              <TypeSample
                class="lab-sample is-trim is-pretty"
                id="lab-sample"
                style={`--t-size:11.5pt;--t-lh:1.6;--t-measure:34em;--t-gap:1.2em;--t-font:${DEFAULT_FONT}`}
              />
            </div>

            <div class="readout-css">
              <div class="readout-css-head">
                <span>生成 CSS</span>
                <button class="mini-btn" type="button" data-copy="lab">
                  <Icon name="copy" />
                  复制
                </button>
              </div>
              <pre><code data-css-out></code></pre>
            </div>
          </div>

          <aside class="lab-readout" aria-label="合规读数">
            <div class="readout-head">
              <span class="readout-label">合规检查</span>
              <span class="readout-score" data-score-box>
                <strong data-score>5</strong>/5
              </span>
            </div>

            <p class="readout-verdict" data-verdict>
              五项全部达标，这套可以直接抄走。
            </p>

            <ul class="checks">
              {RULES.map((rule) => (
                <li class="check" data-check={rule.key}>
                  <span class="check-dot" aria-hidden="true" />
                  <span class="check-name">{rule.name}</span>
                  <span class="check-val" data-check-val={rule.key}>
                    {rule.init}
                  </span>
                  <span class="check-hint">{rule.spec}</span>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <!-- 3. 五套方案 ---------------------------------------------------- -->
    <section class="ty-section">
      <SectionHead label="五套完整方案" />
      <div class="ty-toolbar">
        <p class="ty-lede">
          每一张都是真实渲染的排版样例，不是截图。<strong>正文可以直接点进去改</strong>
          ，改一处，五张卡同步；挑中哪套就点「套用到试验台」，参数会原样搬上去。
        </p>
        <button class="mini-btn" type="button" data-reset-text>
          <Icon name="arrowLeft" />
          恢复示例文字
        </button>
      </div>

      <div class="spec-grid">
        {SPECIMENS.map((spec) => (
          <TypeSpecimen spec={spec} />
        ))}
        <aside class="spec spec--summary">
          <p class="summary-kicker">CHECKLIST</p>
          <h3>五种场景，一套判据</h3>
          <p>
            上面五套的差别不在字体本身，而在这五个数字。换项目时不用重新想：先确定读者离屏幕多远，再定字号；字号定了，行宽和行距跟着走。
          </p>
          <a class="mini-btn" href="#lab">
            <Icon name="arrowUp" />
            回到试验台
          </a>
        </aside>
      </div>
    </section>

    <!-- 4. 修饰 -------------------------------------------------------- -->
    <section class="ty-section">
      <SectionHead label="八处修饰" />
      <p class="ty-lede">
        参数对了只算及格。下面这八处是「一眼看上去专业」和「说不上哪里怪」之间的差别，每一项都只是一个
        CSS 属性。
      </p>
      <div class="deco-grid">
        {DECOS.map((deco) => (
          <div class="deco">
            <h3>{deco.name}</h3>
            <p>{deco.note}</p>
            <code>{deco.css}</code>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { initSpecimen } from '../scripts/modules/specimen.js';
  initSpecimen();
</script>
