---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="404" description="页面不存在" noindex bodyClass="page-404">
  <div class="shell">
    <div class="notfound">
      <p class="kicker">ERROR</p>
      <h1>404</h1>
      <p class="page-lede">这个地址不存在，也许它已经被重写、移动，或者从未存在过。</p>
      <p>
        <a class="btn" href="/">返回首页 <Icon name="arrowRight" /></a>
      </p>
    </div>
  </div>
</BaseLayout>
