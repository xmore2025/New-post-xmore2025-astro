---
/**
 * 统一图标组件：全部 24×24 线性图标，颜色继承 currentColor
 * 用法：<Icon name="search" /> 或 <Icon name="github" size={14} />
 */
const ICONS = {
  search: {
    body: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>',
  },
  sun: {
    body: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/>',
  },
  moon: {
    body: '<path d="M20.5 14.2A8.6 8.6 0 1 1 9.8 3.5a6.7 6.7 0 0 0 10.7 10.7z"/>',
  },
  arrowRight: {
    body: '<path d="M4.5 12h14M13 6.5l5.5 5.5L13 17.5"/>',
  },
  arrowUpRight: {
    body: '<path d="M7 17 17 7M8.5 7H17v8.5"/>',
  },
  rss: {
    body: '<path d="M4.5 11.5a8 8 0 0 1 8 8M4.5 4.5a15 15 0 0 1 15 15"/><circle cx="5.2" cy="18.8" r="1.5" fill="currentColor" stroke="none"/>',
  },
  github: {
    filled: true,
    body: '<path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/>',
  },
  menu: {
    body: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  },
  close: {
    body: '<path d="M6 6l12 12M18 6 6 18"/>',
  },
  mark: {
    body: '<path d="M12 2.8 21 12l-9 9.2L3 12l9-9.2Z"/><path d="M12 2.8V21.2"/>',
  },
};

const { name = 'mark', size, class: className = '' } = Astro.props;
const icon = ICONS[name] ?? ICONS.mark;
---

<span class={`ico ${className}`} aria-hidden="true">
  <svg
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill={icon.filled ? 'currentColor' : 'none'}
    stroke={icon.filled ? 'none' : 'currentColor'}
    stroke-width={icon.filled ? undefined : 1.7}
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={icon.body}
  />
</span>
