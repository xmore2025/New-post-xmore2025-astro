    body: '<path d="M17.5 3h3.2l-7 8 8.2 10h-6.4l-5-6.1L4.7 21H1.5l7.5-8.6L1.1 3h6.6l4.5 5.9L17.5 3Zm-1.1 16.4h1.8L7.7 4.7H5.8l10.6 14.7Z"/>',
  },
  telegram: {
    filled: true,
    body: '<path d="M21.94 4.6 18.7 19.9c-.24 1.08-.88 1.35-1.78.84l-4.95-3.65-2.39 2.3c-.27.27-.5.5-1 .5l.34-4.85 9.2-8.31c.4-.36-.09-.56-.62-.2L6.2 13.4 1.3 11.86c-1.06-.33-1.08-1.06.22-1.57L20.6 3.1c.88-.33 1.66.2 1.34 1.5Z"/>',
  },
  calendar: {
    body: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.4"/><path d="M3.5 9.5h17M8 3v3.5M16 3v3.5"/>',
  },
  clock: {
    body: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 1.8"/>',
  },
  hash: {
    body: '<path d="M5 9h14M5 15h14M9.5 4 8 20M16 4l-1.5 16"/>',
  },
  link: {
    body: '<path d="M10 14a3.5 3.5 0 0 0 5 0l3-3a3.5 3.5 0 0 0-5-5l-1.5 1.5M14 10a3.5 3.5 0 0 0-5 0l-3 3a3.5 3.5 0 0 0 5 5l1.5-1.5"/>',
  },
};

const { name = 'mark', size, class: className = '' } = Astro.props;
const icon = ICONS[name] ?? ICONS.mark;
---

<span class={`ico ${className}`} aria-hidden="true">
  <svg
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill={icon.filled ? 'currentColor' : 'none'}
    stroke={icon.filled ? 'none' : 'currentColor'}
    stroke-width={icon.filled ? undefined : 1.7}
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={icon.body}
  />
</span>
