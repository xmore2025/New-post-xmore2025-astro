  },
  mark: {
    body: '<path d="M5 5 19 19"/><path d="M19 5 5 19" opacity="0.8"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/>',
  },
  arrowLeft: {
    body: '<path d="M19.5 12h-14M11 6.5 5.5 12 11 17.5"/>',
  },
  arrowUp: {
    body: '<path d="M12 19.5V4.5M6.5 11 12 5.5 17.5 11"/>',
  },
  copy: {
    body: '<rect x="9" y="9" width="11" height="11" rx="2.4"/><path d="M15 5.6A2.4 2.4 0 0 0 12.6 3.2H6.2A2.4 2.4 0 0 0 3.8 5.6v6.4A2.4 2.4 0 0 0 6.2 14.4"/>',
  },
