---
import Icon from './Icon.astro';
import NavLinks from './NavLinks.astro';
import { site } from '../config';
---

<header class="site-header" id="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${site.title} 首页`}>
      <span class="brand-mark">
        <Icon name="mark" />
      </span>
      <span class="brand-text">{site.title}</span>
    </a>

    <NavLinks class="nav nav--desktop" ariaLabel="主导航" />

    <div class="header-actions">
      <button
        class="icon-btn search-trigger"
        type="button"
        aria-label="搜索文章（快捷键 ⌘K）"
        aria-controls="search-modal"
        aria-expanded="false"
        data-search-open
      >
        <Icon name="search" />
        <kbd data-shortcut>⌘K</kbd>
      </button>

      <button
        class="icon-btn theme-btn"
        type="button"
        aria-label="切换明暗主题"
        aria-pressed="false"
        data-theme-toggle
      >
        <span class="theme-icon theme-icon--light">
          <Icon name="sun" />
        </span>
        <span class="theme-icon theme-icon--dark">
          <Icon name="moon" />
        </span>
      </button>

      <button
        class="icon-btn menu-btn"
        type="button"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span class="menu-icon menu-icon--open">
          <Icon name="menu" />
        </span>
        <span class="menu-icon menu-icon--close">
          <Icon name="close" />
        </span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <div class="shell">
      <NavLinks class="nav" ariaLabel="移动端导航" />
    </div>
  </div>
</header>
