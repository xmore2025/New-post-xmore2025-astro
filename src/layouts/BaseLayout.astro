---
import '../styles/main.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import { site } from '../config';

const {
  title = '',
  description = '',
  bodyClass = '',
  path: pathProp,
  noindex = false,
  type,
  published,
  modified,
  structuredData,
} = Astro.props;

const path = pathProp ?? Astro.url.pathname;
const pageTitle = title ? `${title} · ${site.titleSuffix}` : `${site.title} — ${site.tagline}`;
const desc = description || site.description;
const canonical = noindex ? '' : `${site.url}${path}`;
const isArticle = /^\/posts\/[^/]+\/$/.test(path);
const ogType = type ?? (isArticle ? 'article' : 'website');
const ogImage = `${site.url}/og.png`;

/* 站点级结构化数据：每个页面都带上 WebSite + Organization，
   页面自己的节点（文章 / 面包屑）通过 @graph 合并进来。 */
const siteGraph = [
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.title,
    description: site.description,
    inLanguage: site.lang,
    publisher: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'Organization',
    '@id': `${site.url}/#organization`,
    name: site.title,
    url: site.url,
    logo: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
    sameAs: [site.social?.github, site.social?.x].filter(Boolean),
  },
];
const pageNodes = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const jsonLd = { '@context': 'https://schema.org', '@graph': [...siteGraph, ...pageNodes] };

/* 让浏览器提前预渲染同站链接：点击时几乎没有等待，且不需要任何 JS 运行时 */
const speculationRules = {
  prerender: [
    {
      where: {
        and: [
          { href_matches: '/*' },
          { not: { href_matches: '/*.xml' } },
          { not: { href_matches: '/*.json' } },
          { not: { selector_matches: '[target=_blank]' } },
          { not: { selector_matches: '[download]' } },
        ],
      },
      eagerness: 'moderate',
    },
  ],
};
---

<!doctype html>
<html lang={site.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />

    <!-- 首屏前设定主题，避免闪烁（必须是阻塞脚本，且早于样式表） -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={site.author} />
    <meta name="generator" content={Astro.generator} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta
        name="robots"
        content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      />
    )}

    <meta
      name="theme-color"
      content="#faf9f7"
      media="(prefers-color-scheme: light)"
      data-theme-color="light"
    />
    <meta
      name="theme-color"
      content="#0c0c0d"
      media="(prefers-color-scheme: dark)"
      data-theme-color="dark"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:site_name" content={site.title} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${site.title} — ${site.tagline}`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="zh_CN" />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
    {!noindex && (
      <script type="speculationrules" set:html={JSON.stringify(speculationRules)}></script>
    )}
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <div class="backdrop" aria-hidden="true">
      <div class="backdrop-grid"></div>
    </div>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <SearchModal />

    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>
