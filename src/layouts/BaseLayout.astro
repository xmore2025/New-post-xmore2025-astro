---
import '../styles/main.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config';

const {
  title = '',
  description = '',
  bodyClass = '',
  path: pathProp,
  noindex = false,
} = Astro.props;

const path = pathProp ?? Astro.url.pathname;
const pageTitle = title ? `${title} · ${site.titleSuffix}` : `${site.title} — ${site.tagline}`;
const desc = description || site.description;
const canonical = noindex ? '' : `${site.url}${path}`;
const ogType = /^\/posts\/[^/]+\/$/.test(path) ? 'article' : 'website';
---

<!doctype html>
<html lang={site.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- 首屏前设定主题，避免闪烁 -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={site.author} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0d" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:site_name" content={site.title} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="zh_CN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={`${site.url}/og.png`} />

    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="backdrop" aria-hidden="true"><div class="backdrop-grid"></div></div>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <SearchModal />

    <button
      class="to-top"
      type="button"
      aria-label="回到顶部"
      data-to-top
      hidden
    >
      <Icon name="arrowUp" />
    </button>

    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>
